include(FetchContent)
FetchContent_Declare(imm_mariadb
    URL https://codeload.github.com/mariadb-corporation/mariadb-connector-c/tar.gz/refs/tags/v3.4.11
    URL_HASH SHA256=7cdb35c571dd0c187f806f569285829d31b4aba4feb93957a034b0b1e887e276
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    SOURCE_SUBDIR imm-populate-only)
FetchContent_MakeAvailable(imm_mariadb)
set(WITH_UNIT_TESTS OFF CACHE BOOL "" FORCE)
set(WITH_SSL OPENSSL CACHE STRING "" FORCE)
set(CLIENT_PLUGIN_CACHING_SHA2_PASSWORD STATIC CACHE STRING "" FORCE)
set(CLIENT_PLUGIN_SHA256_PASSWORD STATIC CACHE STRING "" FORCE)
set(INSTALL_PLUGINDIR lib/mariadb/plugin)
add_subdirectory("${imm_mariadb_SOURCE_DIR}" "${imm_mariadb_BINARY_DIR}" EXCLUDE_FROM_ALL)
file(READ "${imm_mariadb_SOURCE_DIR}/libmariadb/secure/openssl.c" openssl_source)
file(READ "${CMAKE_CURRENT_LIST_DIR}/mariadb/memory-ca.c" memory_ca_source)
string(REPLACE "static int ma_tls_set_certs" "${memory_ca_source}\nstatic int ma_tls_set_certs" openssl_source "${openssl_source}")
string(REPLACE "SSL_CTX_load_verify_locations(ctx," "load_memory_ca(ctx," openssl_source "${openssl_source}")
string(REPLACE "mysql->host" "tls_peer_name(mysql)" openssl_source "${openssl_source}")
file(WRITE "${imm_mariadb_BINARY_DIR}/openssl-memory-ca.c" "${openssl_source}")
get_target_property(connector_sources mariadb_obj SOURCES)
set(replaced_sources "")
foreach(source IN LISTS connector_sources)
    if(source MATCHES "(^|/)secure/openssl\\.c$")
        list(APPEND replaced_sources "${imm_mariadb_BINARY_DIR}/openssl-memory-ca.c")
    else()
        list(APPEND replaced_sources "${source}")
    endif()
endforeach()
set_property(TARGET mariadb_obj PROPERTY SOURCES "${replaced_sources}")
target_include_directories(mariadbclient PUBLIC "${imm_mariadb_SOURCE_DIR}/include" "${imm_mariadb_BINARY_DIR}/include")
